# Raspberry Pi 5 optimized configuration
THREADS=4
CONTEXT_SIZE=2048
F16=true
GPU_LAYERS=0
MODELS_PATH=/models

# Supported models for Raspberry Pi 5 (lightweight and efficient)
# Available models for ARM64/CPU:
# - phi-2 (2.7B parameters, good balance)
# - phi-3-mini (3.8B parameters)
# - gemma-2b (2B parameters, very lightweight)
# - llama-3.2-1b (1B parameters, fastest)
# - mistral-7b-instruct (7B, slower but higher quality)

# Default model to load on startup
DEFAULT_MODEL=phi-2

# Performance optimizations for Pi 5
MMAP=true
MLOCK=false
NUMA=false

# Image generation (enabled, Pi 5 optimized)
IMAGE_MODEL_ENABLED=true
IMAGE_MODEL=dreamshaper-8-lcm-ggml
DIFFUSION_STEPS=20
IMAGE_SIZE=512x512

# Audio features (works well on Pi 5)
TTS_ENABLED=true
STT_ENABLED=true

# API settings
CORS_ALLOW_ORIGINS=*
GALLERIES=[{"name":"model-gallery","url":"github:go-skynet/model-gallery/index.yaml"},{"url":"github:go-skynet/model-gallery/huggingface.yaml","name":"huggingface"}]