# AI Model Training Environment Configuration for Raspberry Pi 5

# LocalAI Settings
THREADS=4
CONTEXT_SIZE=2048
F16=true
GPU_LAYERS=0
MODELS_PATH=/models

# Training Configuration
TRAINING_DATA_PATH=/training/datasets
OUTPUT_MODEL_PATH=/training/models
CHECKPOINT_PATH=/training/checkpoints

# Jupyter Lab Configuration
JUPYTER_TOKEN=localai123
JUPYTER_ENABLE_LAB=yes

# Ollama Configuration
OLLAMA_HOST=0.0.0.0
OLLAMA_MODELS_PATH=/root/.ollama/models

# HuggingFace Configuration
HF_HOME=/root/.cache/huggingface
TRANSFORMERS_CACHE=/root/.cache/huggingface/transformers
HF_DATASETS_CACHE=/root/.cache/huggingface/datasets

# MLflow Configuration
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# Training Parameters (for fine-tuning)
LEARNING_RATE=5e-5
BATCH_SIZE=2  # Small batch size for Pi 5
MAX_STEPS=1000
SAVE_STEPS=100
EVAL_STEPS=50
WARMUP_STEPS=100

# Model Creation Settings
MAX_SEQ_LENGTH=512  # Reduced for Pi 5
GRADIENT_ACCUMULATION_STEPS=8  # Simulate larger batch sizes

# Supported model formats for Pi 5
SUPPORTED_FORMATS=ggml,gguf,safetensors,pytorch

# Default models for training base
BASE_MODELS=microsoft/DialoGPT-small,distilbert-base-uncased,google/flan-t5-small